# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

prefix         = ""   # naming prefix for all resources, e.g. "ddps"
awscli_profile = ""   # AWS CLI profile name
ami_id         = ""   # AMI with ShuntServe installed at /home/ubuntu/ShuntServe
key_name       = ""   # EC2 key pair name
hf_token       = ""   # HuggingFace token with access to meta-llama/Llama-3.1-70B-Instruct

# Optional overrides (defaults shown)
# region             = "us-west-2"
# availability_zone  = "us-west-2a"
# head_instance_type = "m5.xlarge"
# root_volume_size   = 300
